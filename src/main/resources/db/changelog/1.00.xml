<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- 初始化 schema（兼容 Heroku 和本地） -->
    <changeSet id="000-init-schema" author="system">
<!--        <preConditions onFail="MARK_RAN">-->
<!--            <not>-->
<!--                <tableExists schemaName="public" tableName="user"/>-->
<!--            </not>-->
<!--        </preConditions>-->
        <sql>CREATE SCHEMA IF NOT EXISTS public</sql>
        <sql>GRANT ALL ON SCHEMA public TO public</sql>
    </changeSet>

    <!-- USER TABLE -->
    <changeSet id="002" author="rachel-d">
        <createTable tableName="user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="first_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
        </createTable>

    </changeSet>
    <!-- PROFILE TABLE -->
    <changeSet id="003" author="rachel-d">
        <createTable tableName="profile">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="birthday" type="DATE">
            </column>
            <column name="phone" type="varchar(20)">
            </column>
            <column name="image_url" type="varchar(255)">

            </column>
            <column name="about_me" type="text">

            </column>
            <column name="profession" type="varchar(255)">

            </column>
            <column name="sex" type="varchar(10)">

            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_profile" references="user(id)"/>
            </column>
        </createTable>

    </changeSet>
    <!-- SOCIAL TABLE -->
    <changeSet id="004" author="rachel-d">
        <createTable tableName="social">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_social" references="user(id)"/>
            </column>
        </createTable>
    </changeSet>


    <!-- EXPERIENCE TABLE -->
    <changeSet id="005" author="rachel-d">
        <createTable tableName="experience">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="company" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
            </column>
            <column name="started_at" type="TIMESTAMP">
            </column>
            <column name="ended_at" type="TIMESTAMP">
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_experience" references="user(id)"/>
            </column>
        </createTable>
    </changeSet>

    <!-- PROJECT TABLE -->
    <changeSet id="006" author="rachel-d">
        <createTable tableName="project">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_project" references="user(id)"/>
            </column>
        </createTable>
    </changeSet>
    <!-- SKILLS TABLE -->
    <changeSet id="007" author="rachel-d">
        <createTable tableName="skills">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_skill" references="user(id)"/>
            </column>

        </createTable>
    </changeSet>

    <!-- HOBBIES TABLE -->
    <changeSet id="008" author="rachel-d">
        <createTable tableName="hobbies">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="image_url" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
            </column>
            <column name="updated_at" type="TIMESTAMP">
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_user_hobby" references="user(id)"/>
            </column>

        </createTable>
    </changeSet>

    <!-- TECHNOLOGY-SKILL RELATIONSHIP -->
    <changeSet id="009" author="rachel-d">
        <createTable tableName="technologies_skills">
            <column name="experience_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="skill_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="technologies_skills" baseColumnNames="experience_id"
                                 referencedTableName="experience" referencedColumnNames="id"
                                 constraintName="fk_skill_experience"  />

        <addForeignKeyConstraint baseTableName="technologies_skills" baseColumnNames="skill_id"
                                 constraintName="fk_experience_skill" referencedTableName="skills"
                                 referencedColumnNames="id" />

        <addUniqueConstraint
                tableName="technologies_skills"
                columnNames="experience_id, skill_id"
                constraintName="uq_technologies_skills"
        />

    </changeSet>

    <!--    Summaries-->
    <changeSet id="010" author="rachel">
        <createTable tableName="summaries">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="value" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="experience_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_experience_summary" references="experience(id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
